{
  "dependencies": {
    "@qorechain/sdk": "0.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "description": "DCA Guard: an autonomous DCA agent for QoreChain testnet that buys on schedule only inside a scoped window, with value and target limits, and pauses outside them.",
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.0"
  },
  "name": "dca-guard",
  "private": true,
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite",
